# ── Public (client-safe; exposed to the browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # publishable / anon key ONLY
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=           # Web Push (client subscribe) — public

# ── Server-only (NEVER prefix with NEXT_PUBLIC) ────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=              # admin client: Server Actions / Edge Functions / relatives portal only
SUPABASE_JWT_SECRET=
DATABASE_URL=

# ── Edge / notifications ───────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=             # v1 relative channel = in_app + (optional) LINE
RESEND_API_KEY=                        # optional email
CRON_SECRET=                           # guards the Vercel cron route /api/cron/reminders
VAPID_PRIVATE_KEY=                     # Web Push (push-sender) — server-only
VAPID_SUBJECT=mailto:ops@betterbrain.example

# ── NOT env (documented so nobody re-adds them) ────────────────────────────
# Geofence radius, late/early thresholds, selfie-required → `settings` table,
#   editable by the Director at /staff/settings (read via getSettings()).
# Operating timezone (Asia/Bangkok) → fixed code constant in lib/date/buddhist.ts.
